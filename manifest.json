{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "__MSG_extName__",
  "short_name": "AUVYQ",
  "version": "0.3.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "offscreen",
    "webNavigation",
    "cookies",
    "tabs"
  ],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/cosmetic-injector.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/scriptlet-dispatch.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/fp-shields.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/warning-banner.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "main",
        "enabled": true,
        "path": "rules/main.json"
      },
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/easylist.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules/easyprivacy.json"
      },
      {
        "id": "annoyances",
        "enabled": true,
        "path": "rules/annoyances.json"
      },
      {
        "id": "ads-trackers",
        "enabled": true,
        "path": "rules/ads-trackers.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["resources/*"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "ui/dashboard/dashboard.html"
}
